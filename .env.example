# Copy this file to .env (never commit .env) and fill in both values.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Folder holding config.toml and certs\ for the verifier. Use forward slashes.
VERIFIER_CONFIG_DIR=C:/Users/glyde/verifier-config

# --- Optional: the payment step, tried against the fake checkout server ---
# Uncomment all three lines, then run:  docker compose --profile fakepay up --build
# These are made-up values for local testing only. Never reuse real keys here.
#PAYMENT_GATE=1
#ZC_API_KEY=fake-api-key-for-local-testing-1234
#ZC_WEBHOOK_SECRET=fake-webhook-secret-for-local-testing-1234

# --- Optional: the REAL ZecCheckout on the Zcash testnet ---
# Needs a testnet viewing key (see README). Replace the fake keys above with random ones,
# then run:  docker compose --profile zec up --build
#ZC_UFVK=uviewtest1...
#ZC_URL=http://zeccheckout:10000

# --- Optional: site hardening (see docs/HARDENING.md) ---
# Requests per minute per address for the age-check and payment routes (0 = off).
#RATE_LIMIT_PER_MIN=30
# Set to 1 when the site is served over https, so the cookie is never sent over http.
#SESSION_COOKIE_SECURE=1
# Set to 1 behind a tunnel or reverse proxy, so rate limits count each visitor separately.
# scripts/go-public.ps1 sets this and the two lines above for you.
#TRUST_PROXY=1
